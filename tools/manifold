def cmd_stability():
    print("================================================================================")
    print("🛡️  LEDGER AUDIT: NUMERICAL FIELD STABILITY & ENERGY DRIFT PROFILE")
    print("================================================================================")
    reports = parse_ledger_blocks("RESONANCE_STABILITY_REPORT")
    if not reports:
        print("  [No active stability verification frame signatures discovered]")
        return
        
    print(f"Total Logged Energy Audits: {len(reports)}")
    last_ts, last_msg = reports[-1]
    print(f"Latest Ingestion State     : {last_msg}")
    print("================================================================================")

def main():
    if len(sys.argv) < 2:
        print_usage()
        sys.exit(1)
        
    cmd = sys.argv[1].lower()
    if cmd == "status":
        cmd_status()
    elif cmd == "audit-semantic":
        cmd_audit_semantic()
    elif cmd == "audit-lineage":
        cmd_audit_lineage()
    elif cmd == "stability":
        cmd_stability()
    else:
        print(f"⚠️  Unknown command flag: {sys.argv[1]}")
        print_usage()
        sys.exit(1)

if __name__ == "__main__":
    main()
