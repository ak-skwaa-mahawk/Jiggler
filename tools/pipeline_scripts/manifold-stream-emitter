#!/usr/bin/env python3
import socket
import json
import time
import sys
import math
from pathlib import Path

gs_root = Path.home() / "Tordial-GS"
if gs_root.exists() and str(gs_root) not in sys.path:
    sys.path.insert(0, str(gs_root))

try:
    from core.mesh.feedback_manifold_bridge import FeedbackManifoldBridge
    bridge = FeedbackManifoldBridge(num_nodes=8)
    USE_BRIDGE = True
except Exception:
    USE_BRIDGE = False

UDP_HOST = "127.0.0.1"
UDP_PORT = 9999
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

nodes = ["EDGE_NODE_01", "EDGE_NODE_02", "CORE_ORBIT_03", "RELAY_NORTH_04"]

print(f"🛰️  [TELEMETRY EMITTER]: Dynamic stochastic streaming to UDP {UDP_HOST}:{UDP_PORT} (Ctrl+C to halt)")

step = 0
try:
    while True:
        node_id = nodes[step % len(nodes)]
        
        # Inject dynamic drift using trigonometric phase progression
        t = step * 0.15
        base_strain = 20.0 + 15.0 * math.sin(t) + (step % 5) * 2.5
        strain = round(max(5.0, min(70.0, base_strain)), 2)
        
        vitality = round(0.75 + 0.20 * math.cos(t * 0.8), 4)
        vitality = max(0.40, min(0.99, vitality))
        
        lyap = round(-4.5 - 2.5 * abs(math.sin(t * 0.5)), 3)

        payload = {
            "node_id": node_id,
            "strain_percent": strain,
            "vitality_score": vitality,
            "lyapunov_exp": lyap
        }

        sock.sendto(json.dumps(payload).encode("utf-8"), (UDP_HOST, UDP_PORT))
        print(f"[+] Dispatched -> Node={node_id:<14} | Strain={strain:>5.1f}% | Vitality={vitality:.4f} | Lyap={lyap:.3f}")
        
        step += 1
        time.sleep(5)
except KeyboardInterrupt:
    print("\n🛑 Stream generator terminated.")
